datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  password_hash      String
  age                Int?
  gender             String?
  education          String?
  occupation         String?
  preferred_language String?
  district           String?
  state              String?
  created_at         DateTime @default(now())

  assessments      Assessment[]
  learning_path    LearningPath?
  user_progress    UserProgress[]
  voice_practices  VoicePractice[]
  gamification     UserGamification?
  learning_reports LearningReport[]
}

model Curriculum {
  id        Int     @id @default(autoincrement())
  language  String
  level     String
  category  String
  title     String
  content   String
  duration  Int
  user_id   Int? // Null if standard lesson, set if custom lesson
  is_custom Boolean @default(false)

  quizzes       Quiz[]
  user_progress UserProgress[]
}

model Assessment {
  id             Int      @id @default(autoincrement())
  user_id        Int
  reading_score  Float?
  writing_score  Float?
  speaking_score Float?
  overall_score  Float?
  literacy_level String?
  feedback       String?
  created_at     DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
}

model LearningPath {
  id                Int    @id @default(autoincrement())
  user_id           Int    @unique
  recommended_level String
  roadmap           Json

  user User @relation(fields: [user_id], references: [id])
}

model Quiz {
  id             Int    @id @default(autoincrement())
  lesson_id      Int
  question       String
  options        Json
  correct_answer String

  lesson Curriculum @relation(fields: [lesson_id], references: [id])
}

model UserProgress {
  id            Int       @id @default(autoincrement())
  user_id       Int
  curriculum_id Int
  status        String // e.g., "in_progress", "completed"
  score         Float?
  attempts      Int       @default(1)
  history       Json      @default("[]")
  completed_at  DateTime? @default(now())

  user       User       @relation(fields: [user_id], references: [id])
  curriculum Curriculum @relation(fields: [curriculum_id], references: [id])
}

model VoicePractice {
  id                 Int      @id @default(autoincrement())
  user_id            Int
  drill_id           String?
  target_text        String
  transcription      String
  overall_score      Float
  accuracy_score     Float?
  fluency_score      Float?
  completeness_score Float?
  word_analysis      Json?
  feedback           Json?
  language           String   @default("English")
  created_at         DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
}

model UserGamification {
  id               Int      @id @default(autoincrement())
  user_id          Int      @unique
  xp               Int      @default(0)
  level            Int      @default(1)
  current_streak   Int      @default(1)
  longest_streak   Int      @default(1)
  last_active_date String?
  active_dates     Json     @default("[]")
  unlocked_badges  Json     @default("[]")
  daily_quests     Json     @default("[]")
  updated_at       DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
}

model LearningReport {
  id                     Int      @id @default(autoincrement())
  user_id                Int
  report_id              String   @unique
  overall_literacy_index Float
  competency_level       String
  skills_breakdown       Json
  strengths              Json
  growth_areas           Json
  recommendations        Json
  created_at             DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
}
